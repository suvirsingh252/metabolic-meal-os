OPENAI_API_KEY=
FDC_API_KEY=
# Authentication (private by default).
# APP_AUTH_TOKEN is REQUIRED in production. When it is missing and no opt-out
# is set, every request fails closed with 503.
APP_AUTH_TOKEN=
# Local/dev only: explicitly run without authentication.
ALLOW_UNAUTHENTICATED=false
# Deprecated legacy opt-out; PRIVATE_DEPLOYMENT_MODE=false still works for one
# release (with a console warning). Use ALLOW_UNAUTHENTICATED=true instead.
# PRIVATE_DEPLOYMENT_MODE=
NOTION_API_KEY=
NOTION_MEALS_DATABASE_ID=
NOTION_INGREDIENTS_DATABASE_ID=
NOTION_FEEDBACK_DATABASE_ID=
NOTION_MEAL_PLAN_SOURCE_ID=
NOTION_MEAL_PLAN_DATABASE_ID=
NOTION_WEEKLY_PLANS_DATABASE_ID=
NOTION_MEAL_TEMPLATES_DATABASE_ID=
# iPhone Share Intake (Beta 3.6)
IOS_SHORTCUT_TOKEN=
NOTION_MEAL_INTAKE_DATABASE_ID=
